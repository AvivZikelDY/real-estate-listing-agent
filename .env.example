LLM_MODE=fake
LLMOD_API_KEY=
LLMOD_BASE_URL=
LLMOD_MODEL=

# TOOLS_MODE picks the tool implementations: "mock" (offline, deterministic)
# or "nir" (real, live govmap + Overpass HTTP calls).
TOOLS_MODE=mock
# TOOL_BACKEND picks the transport, NOT the data: "mock" means the local
# in-process executor (which is what actually honours TOOLS_MODE above);
# "mcp" is an unimplemented placeholder. Leave this as "mock".
TOOL_BACKEND=mock
MCP_SERVER_URL=
MCP_REQUEST_TIMEOUT_SECONDS=10
# Sized for the live tools: Overpass's mirror fallback can run tens of
# seconds. Drop back to 8 when running with TOOLS_MODE=mock.
TOOL_TIMEOUT_SECONDS=120

# --- Phase 17: request limits, deduplication, and execution deadlines ---
MAX_PROMPT_LENGTH=4000
MAX_CLAIMS=8
MAX_TOOL_CALLS=3
# Must stay below LLM_REQUEST_TIMEOUT_SECONDS, which is a hard cut-off.
MAX_TOTAL_TOOL_EXECUTION_SECONDS=240
LLM_REQUEST_TIMEOUT_SECONDS=290
